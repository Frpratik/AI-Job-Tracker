# JobTracker Production Environment Configuration Template

# Database
POSTGRES_DB=jobtracker
POSTGRES_USER=jobtracker
POSTGRES_PASSWORD=replace_with_secure_production_password
DATABASE_URL=postgres://jobtracker:replace_with_secure_production_password@db:5432/jobtracker

# Django Backend
SECRET_KEY=replace_with_long_random_django_secret_key_at_least_50_chars
DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1,api.yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# Redis
REDIS_URL=redis://redis:6379/0

# Next.js Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NODE_ENV=production

# AI Assistant Providers (Optional external LLMs)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
